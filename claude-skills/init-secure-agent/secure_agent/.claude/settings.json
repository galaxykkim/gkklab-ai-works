{
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.git/**)",
      "Read(**/.DS_Store)",
      "Read(**/*.log)",
      "Read(**/tmp/**)",
      "Read(**/.env*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.cert)",
      "Read(**/local.properties)",
      "Read(**/*.xcconfig)",
      "Read(**/secrets.xml)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/firebase_options.dart)",
      "Read(**/.firebaserc)",
      "Read(**/firebase-debug.log)",
      "Read(**/service-account*.json)",
      "Read(**/fastlane/*.json)",
      "Read(**/fastlane/.env*)",
      "Read(**/fastlane/report.xml)",
      "Read(**/fastlane/screenshots/**)",
      "Read(**/fastlane/test_output/**)",
      "Read(**/fastlane/gc_keys/**)",
      "Read(**/ci_scripts/artifacts/**)",
      "Read(**/.dart_tool/**)",
      "Read(**/build/**)",
      "Read(**/.packages)",
      "Read(**/.pub-cache/**)",
      "Read(**/.pub/**)",
      "Read(**/*.g.dart)",
      "Read(**/*.freezed.dart)",
      "Read(**/*.mocks.dart)",
      "Read(**/ios/Pods/**)",
      "Read(**/ios/.symlinks/**)",
      "Read(**/ios/Flutter/Generated.xcconfig)",
      "Read(**/DerivedData/**)",
      "Read(**/*.xcresult/**)",
      "Read(**/*.xcodeproj/xcuserdata/**)",
      "Read(**/*.xcworkspace/xcuserdata/**)",
      "Read(**/.gradle/**)",
      "Read(**/gradlew*)",
      "Read(**/capture/**)",
      "Read(**/.idea/**)",
      "Read(**/.vscode/**)",
      "Read(**/*.iml)",
      "Read(**/.history/**)",
      "Read(**/assets/images/**)",
      "Read(**/assets/videos/**)",
      "Read(**/*.png)",
      "Read(**/*.jpg)",
      "Read(**/*.jpeg)",
      "Read(**/*.svg)",
      "Read(**/*.pdf)",
      "Read(**/*.mp4)",
      "Read(**/*.ttc)",
      "Read(**/*.ttf)",
      "Read(**/*.gif)",
      "Read(**/*.so)",
      "Read(**/*.qn)"
    ]
  },
  "general": {
    "ignore_patterns": [
      "**/node_modules/**",
      "**/.git/**",
      "**/.DS_Store",
      "**/*.log",
      "**/tmp/**",
      "**/.env*",
      "**/*.keystore",
      "**/*.jks",
      "**/*.p12",
      "**/*.p8",
      "**/*.mobileprovision",
      "**/*.cert",
      "**/local.properties",
      "**/*.xcconfig",
      "**/secrets.xml",
      "**/google-services.json",
      "**/GoogleService-Info.plist",
      "**/firebase_options.dart",
      "**/.firebaserc",
      "**/firebase-debug.log",
      "**/service-account*.json",
      "**/fastlane/*.json",
      "**/fastlane/.env*",
      "**/fastlane/report.xml",
      "**/fastlane/screenshots/**",
      "**/fastlane/test_output/**",
      "**/fastlane/gc_keys/**",
      "**/ci_scripts/artifacts/**",
      "**/.dart_tool/**",
      "**/build/**",
      "**/.packages",
      "**/.pub-cache/**",
      "**/.pub/**",
      "**/*.g.dart",
      "**/*.freezed.dart",
      "**/*.mocks.dart",
      "**/ios/Pods/**",
      "**/ios/.symlinks/**",
      "**/ios/Flutter/Generated.xcconfig",
      "**/DerivedData/**",
      "**/*.xcresult/**",
      "**/*.xcodeproj/xcuserdata/**",
      "**/*.xcworkspace/xcuserdata/**",
      "**/.gradle/**",
      "**/gradlew*",
      "**/capture/**",
      "**/.idea/**",
      "**/.vscode/**",
      "**/*.iml",
      "**/.history/**",
      "**/assets/images/**",
      "**/assets/videos/**",
      "**/*.{png,jpg,jpeg,svg,pdf,mp4,ttc,ttf,gif}",
      "**/*.so",
      "**/*.qn"
    ]
  },
  "security": {
    "enable_content_filtering": true,
    "content_filter_rules": [
      {
        "name": "API_Key_High_Entropy_Filter",
        "pattern": "(?=.*[0-9])(?=.*[a-zA-Z])[a-zA-Z0-9\\-_]{20,}",
        "action": "mask",
        "description": "API, Token 등의 민감데이터 노출방지를 위한 옵션."
      }
    ]
  },
  "context": {
    "prefer_local_modules": true,
    "max_file_size_kb": 500,
    "ignore_generated_files": true
  }
}